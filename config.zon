.{
    .blocked = .{
        "ACE-Base64.dll",
        // DLL basenames to block, such as PerfSight.dll
    },
    .shims = .{
        // DLL paths to load, absolute or relative
    },
    // Log executable sections and reconstruction details
    .debug = false,
    // Write selected dumps to working directory
    .dumps = .{
        .text = false,
        .sections = false,
        .imports = false,
    },
    // Open a console before reconstruction
    .console = false,
    // Mute stdout and stderr during reconstruction
    .mute_output = false,
}
